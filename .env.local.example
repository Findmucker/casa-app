NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Push Notifications (FCM) — required for push to work
# Get from Firebase Console > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_VAPID_KEY=

# Firebase Admin SDK (server-side, for sending push notifications)
# Get from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required by the Vercel cron endpoint; generate a long random value
CRON_SECRET=

# Habit reminder scheduling (server-side)
REMINDER_TIME_ZONE=Europe/Lisbon
# Recovery window for delayed free schedulers; delivery is deduplicated
REMINDER_WINDOW_MINUTES=180
# Comma- or newline-separated SHA-256 certificate fingerprints used by the
# Android Trusted Web Activity. Add the local upload certificate and the Play
# App Signing certificate when available.
ANDROID_SHA256_CERT_FINGERPRINTS=
